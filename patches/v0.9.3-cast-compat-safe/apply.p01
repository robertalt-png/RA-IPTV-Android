s=s.replace('speed.setEnabled(!casting);aspect.setEnabled(!casting);audio.setEnabled(!casting);subtitle.setEnabled(!casting);','speed.setEnabled(!isCasting());aspect.setEnabled(!isCasting());audio.setEnabled(!isCasting());subtitle.setEnabled(!isCasting());')
s=s.replace('saveProgress();try{if(castClient!=null)castClient.unregisterCallback(castMediaCallback);}catch(Exception ignored){}if(vlc!=null&&(recording||recordingStarting))','saveProgress();try{if(castClient!=null)castClient.unregisterCallback(castMediaCallback);}catch(Exception ignored){}closeCastRelay();if(vlc!=null&&(recording||recordingStarting))')
p.write_text(s)

