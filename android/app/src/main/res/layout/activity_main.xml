<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
  <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="8dp" android:paddingBottom="6dp">
  <LinearLayout android:id="@+id/brandButton" android:layout_width="wrap_content" android:layout_height="44dp" android:gravity="center_vertical" android:orientation="horizontal" android:clickable="false" android:focusable="false" android:contentDescription="NenoTV">
    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_nenotv_mark" android:scaleType="fitCenter" android:contentDescription="NenoTV"/>
    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="7dp" android:text="NenoTV" android:textColor="#FFD400" android:textSize="17sp" android:textStyle="bold" android:letterSpacing="0.02" android:singleLine="true" android:maxLines="1" android:includeFontPadding="false"/>
  </LinearLayout>
  <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
  <Button android:id="@+id/languageBadge" android:layout_width="48dp" android:layout_height="36dp" android:text="NL" android:textAllCaps="false" android:textColor="#FFF7F8FA" android:textSize="11sp" android:backgroundTint="#151A21" android:contentDescription="Language"/>
  <Button android:id="@+id/planBadge" android:layout_width="58dp" android:layout_height="36dp" android:layout_marginLeft="5dp" android:text="LIGHT" android:textAllCaps="false" android:textStyle="bold" android:textColor="#FF0A0A0A" android:textSize="10sp" android:backgroundTint="#FFD400" android:contentDescription="Plan"/>
  <Button android:id="@+id/menuButton" android:layout_width="48dp" android:layout_height="44dp" android:text="☰" android:textSize="24sp" android:textColor="#FFFFFF" android:backgroundTint="#151A21" android:contentDescription="Menu"/>
  <Button android:id="@+id/searchToggle" android:layout_width="40dp" android:layout_height="36dp" android:layout_marginLeft="5dp" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp" android:text="⌕" android:textSize="22sp" android:textColor="#FFFFFFFF" android:backgroundTint="#151A21" android:visibility="visible" android:contentDescription="Search"/>
  <Button android:id="@+id/settingsButton" android:layout_width="1dp" android:layout_height="1dp" android:text="⚙" android:visibility="gone"/>
  <Button android:id="@+id/tvShareButton" android:layout_width="1dp" android:layout_height="1dp" android:text="TV" android:visibility="gone"/>
  <Button android:id="@+id/profileButton" android:layout_width="1dp" android:layout_height="1dp" android:text="LIGHT" android:visibility="gone"/>
</LinearLayout>
  <LinearLayout android:id="@+id/indexBanner" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:layout_marginBottom="5dp" android:orientation="vertical" android:gravity="center_vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:background="@drawable/bg_search" android:visibility="gone">
  <TextView android:id="@+id/indexBannerText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="11sp" android:maxLines="2" android:ellipsize="end"/>
  <ProgressBar android:id="@+id/indexBannerProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="6dp" android:max="100" android:progress="0" android:indeterminate="false" android:progressTint="#FFD400" android:progressBackgroundTint="#303640"/>
</LinearLayout>
  <FrameLayout android:id="@+id/heroContainer" android:layout_width="match_parent" android:layout_height="185dp" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:background="@drawable/bg_hero" android:clipToOutline="true">
    <ImageView android:id="@+id/heroImage" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_hero_overlay"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="bottom" android:paddingLeft="15dp" android:paddingRight="15dp" android:paddingTop="12dp" android:paddingBottom="12dp">
      <TextView android:id="@+id/heroTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
      <TextView android:id="@+id/heroSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E2E5EA" android:textSize="11.5sp" android:maxLines="1" android:ellipsize="end" android:paddingTop="3dp"/>
      <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="7dp">
        <Button android:id="@+id/heroAction" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="0dp" android:text="▶ Afspelen" android:textAllCaps="false" android:textColor="#FF0A0A0A" android:backgroundTint="#FFD400" android:visibility="gone"/>
        <Button android:id="@+id/heroInfo" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="0dp" android:layout_marginLeft="6dp" android:text="ⓘ Info" android:textAllCaps="false" android:textColor="@color/text" android:backgroundTint="@color/panel2" android:visibility="gone"/>
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
  <EditText android:id="@+id/searchBox" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:layout_marginTop="6dp" android:hint="Zoek in live tv, films en series" android:singleLine="true" android:textColor="@color/text" android:textColorHint="@color/muted" android:paddingLeft="14dp" android:paddingRight="14dp" android:background="@drawable/bg_search" android:visibility="gone"/>
  <LinearLayout android:id="@+id/filterBar" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:layout_marginTop="3dp">
    <Spinner android:id="@+id/categorySpinner" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:spinnerMode="dropdown" android:popupBackground="@color/card"/>
    <Button android:id="@+id/genreButton" android:layout_width="82dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:text="Genre ▾" android:textAllCaps="false" android:textColor="@color/text" android:textSize="11sp" android:backgroundTint="@color/panel2" android:visibility="gone"/>
    <Button android:id="@+id/sortButton" android:layout_width="68dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:text="Sorteren" android:textAllCaps="false" android:textColor="@color/text" android:textSize="10sp" android:backgroundTint="@color/panel2"/>
  </LinearLayout>
  <Spinner android:id="@+id/seasonSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:spinnerMode="dropdown" android:visibility="gone"/>
  <LinearLayout android:id="@+id/epgModeBar" android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal" android:gravity="right|center_vertical" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:visibility="gone">
    <Button android:id="@+id/epgGridButton" android:layout_width="82dp" android:layout_height="38dp" android:text="EPG" android:textAllCaps="false" android:textColor="#FFFFFFFF" android:backgroundTint="@color/accent"/>
    <Button android:id="@+id/epgListButton" android:layout_width="82dp" android:layout_height="38dp" android:layout_marginLeft="6dp" android:text="List" android:textAllCaps="false" android:textColor="@color/text" android:backgroundTint="@color/panel2"/>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="26dp" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp"><ProgressBar android:id="@+id/progress" android:layout_width="17dp" android:layout_height="17dp" android:visibility="gone"/><TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/muted" android:textSize="11sp" android:paddingLeft="7dp"/></LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ListView android:paddingBottom="16dp" android:clipToPadding="false" android:id="@+id/itemList" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="14dp" android:layout_marginRight="14dp" android:divider="@android:color/transparent" android:dividerHeight="6dp" android:scrollbars="none"/>
    <GridView android:listSelector="@drawable/bg_grid_selection" android:drawSelectorOnTop="true" android:paddingBottom="16dp" android:clipToPadding="false" android:id="@+id/itemGrid" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginLeft="10dp" android:layout_marginRight="10dp" android:horizontalSpacing="6dp" android:verticalSpacing="7dp" android:stretchMode="columnWidth" android:gravity="center" android:scrollbars="none" android:visibility="gone"/>
    <ScrollView android:paddingBottom="16dp" android:clipToPadding="false" android:id="@+id/browseScroll" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none"><LinearLayout android:id="@+id/browseContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp"/></ScrollView>
    <ScrollView android:paddingBottom="16dp" android:clipToPadding="false" android:id="@+id/epgBoard" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:scrollbars="none"><LinearLayout android:id="@+id/epgBoardContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingBottom="12dp"/></ScrollView>
  </FrameLayout>
  <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_bottom_nav">
    <Button android:id="@+id/navHome" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="⌂&#10;Home" android:textAllCaps="false" android:textColor="@color/text" android:textSize="10sp" android:backgroundTint="@android:color/transparent"/>
    <Button android:id="@+id/navLive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="●&#10;Live" android:textAllCaps="false" android:textColor="@color/muted" android:textSize="10sp" android:backgroundTint="@android:color/transparent"/>
    <Button android:id="@+id/navEpg" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▦&#10;EPG" android:textAllCaps="false" android:textColor="@color/muted" android:textSize="10sp" android:backgroundTint="@android:color/transparent"/>
    <Button android:id="@+id/navMovies" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▣&#10;Films" android:textAllCaps="false" android:textColor="@color/muted" android:textSize="10sp" android:backgroundTint="@android:color/transparent"/>
    <Button android:id="@+id/navSeries" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="▤&#10;Series" android:textAllCaps="false" android:textColor="@color/muted" android:textSize="10sp" android:backgroundTint="@android:color/transparent"/>
  </LinearLayout>
</LinearLayout>