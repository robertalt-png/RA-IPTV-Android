<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090D">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/ic_nenotv_mark"
            android:contentDescription="SunnyIPTV"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SunnyIPTV"
            android:textColor="#FFD400"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="IPTV PLAYER"
            android:textColor="#A7AFBC"
            android:textSize="12sp"
            android:letterSpacing="0.18"/>
        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="#FFD400"/>
    </LinearLayout>
</FrameLayout>